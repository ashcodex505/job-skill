# Copy to .env.local and adjust. Everything has a sensible local default —
# the app runs with NO env file at all.

# ── Database ────────────────────────────────────────────────────────────
# SQLite file path (default: ./data/resume-tracker.db)
# DATABASE_PATH=./data/resume-tracker.db

# ── Credential encryption ───────────────────────────────────────────────
# keychain (default on macOS): random 256-bit key stored in the macOS Keychain.
# master: derive the key from a master password (scrypt); unlock in Settings.
# ENCRYPTION_MODE=keychain
# Optional for master mode: pre-unlock the vault at boot (otherwise unlock in the UI).
# RESUME_TRACKER_MASTER_PASSWORD=
# Keychain service name override (default: resume-tracker)
# KEYCHAIN_SERVICE=resume-tracker

# ── Resume file storage ─────────────────────────────────────────────────
# local (default): files under ./data/resumes
# supabase: Supabase Storage (free tier) — set the three values below.
# RESUME_STORAGE_DRIVER=local
# RESUME_STORAGE_PATH=./data

# Supabase (only if RESUME_STORAGE_DRIVER=supabase). Create a PRIVATE bucket.
# Credentials/passwords are NEVER stored in Supabase — resume files only.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_BUCKET=resumes

# ── Mac app launcher ────────────────────────────────────────────────────
# Port the packaged app serves on (default 3141)
# RESUME_TRACKER_PORT=3141
